---
import type { CollectionEntry } from "astro:content";
import { withBase } from "../utils/url";

interface Props {
  project: CollectionEntry<"projects">;
  showYear?: boolean;
  imageSizes?: string;
}

const { project, showYear = false, imageSizes = "calc(100vw - 20px)" } = Astro.props;
const data = project.data;
const year = data.date ? new Date(data.date).getUTCFullYear().toString() : "";
---

<a class="project-card" href={withBase(`/${project.slug}`)}>
  <figure>
    <img
      src={withBase(data.cover)}
      sizes={imageSizes}
      alt=""
      loading="lazy"
      decoding="async"
    />
  </figure>
  <div class="project-card__meta">
    <h2>{data.title}</h2>
    {showYear && year && <span class="project-card__year">{year}</span>}
    <p>{data.description}</p>
  </div>
</a>
