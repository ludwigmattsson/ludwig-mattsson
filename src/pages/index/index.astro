---
import { getCollection } from "astro:content";
import Header from "../../components/Header.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { collectionPageSchema, siteKeywords } from "../../utils/seo";
import { withBase } from "../../utils/url";

const projects = (await getCollection("projects"))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const description = "Complete index of design, filmmaking, motion, identity, editorial, and visual storytelling projects by Ludwig Mattsson.";
---

<BaseLayout
  title="Index"
  description={description}
  canonicalPath="/index/"
  keywords={siteKeywords()}
  schema={collectionPageSchema({
    path: "/index/",
    title: "Ludwig Mattsson Project Index",
    description,
    projects
  })}
>
  <Header />
  <main class="index-page">
    <nav class="index-filter" aria-label="Project filters">
      <a class="active" href={withBase("/index/all/")}>All</a>
      <a href={withBase("/index/design/")}>Design</a>
      <a href={withBase("/index/film/")}>Film</a>
    </nav>
    <section class="index-list index-list--grid project-index-grid" aria-label="Project index">
      {projects.map((project) => (
        <ProjectCard
          project={project}
          showYear
          imageSizes="(max-width: 700px) calc(100vw - 20px), calc((100vw - 40px) / 3)"
        />
      ))}
    </section>
  </main>
</BaseLayout>
