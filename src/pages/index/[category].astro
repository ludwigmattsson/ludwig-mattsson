---
import { getCollection } from "astro:content";
import Header from "../../components/Header.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { collectionPageSchema, siteKeywords } from "../../utils/seo";
import { withBase } from "../../utils/url";

export function getStaticPaths() {
  return ["all", "design", "film"].map((category) => ({ params: { category } }));
}

const { category } = Astro.params;
const allProjects = (await getCollection("projects"))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const projects = allProjects.filter((project) => {
  if (category === "all") return true;
  if (category === "design") return ["design", "design-film"].includes(project.data.category);
  if (category === "film") return ["film", "design-film"].includes(project.data.category);
  return false;
});

const yearFor = (date?: string) => (date ? new Date(date).getUTCFullYear().toString() : "");
const labels = {
  all: "All",
  design: "Design",
  film: "Film"
};
const categoryTitle = `${labels[category as keyof typeof labels] || "Project"} Index`;
const description = category === "film"
  ? "Film direction, short film, moving image, and visual storytelling projects by Ludwig Mattsson."
  : category === "design"
    ? "Design systems, identity, editorial, graphic design, and motion design projects by Ludwig Mattsson."
    : "Complete index of design and filmmaking projects by Ludwig Mattsson.";
---

<BaseLayout
  title={categoryTitle}
  description={description}
  canonicalPath={`/index/${category}/`}
  keywords={siteKeywords()}
  schema={collectionPageSchema({
    path: `/index/${category}/`,
    title: `${categoryTitle} — Ludwig Mattsson`,
    description,
    projects
  })}
>
  <Header />
  <main class="index-page">
    <nav class="index-filter" aria-label="Project filters">
      <a class:list={{ active: category === "all" }} href={withBase("/index/all/")}>All</a>
      <a class:list={{ active: category === "design" }} href={withBase("/index/design/")}>Design</a>
      <a class:list={{ active: category === "film" }} href={withBase("/index/film/")}>Film</a>
    </nav>
    <section class="index-list" aria-label="Project index">
      {projects.map((project) => (
        <a class="index-row" href={withBase(`/${project.slug}`)}>
          <span>{project.data.title}</span>
          <span>{yearFor(project.data.date)}</span>
          <span>{project.data.description}</span>
        </a>
      ))}
    </section>
  </main>
</BaseLayout>
