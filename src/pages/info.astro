---
import Header from "../components/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import site from "../content/site.json";
import { personSchema, profilePageSchema, siteKeywords, websiteSchema } from "../utils/seo";

const description = "Ludwig Mattsson is a Stockholm-based filmmaker and designer working across film, design, visual storytelling, branding, motion graphics, and design systems.";
---

<BaseLayout
  title="Information"
  description={description}
  canonicalPath="/info/"
  keywords={siteKeywords()}
  schema={[personSchema(), websiteSchema(), profilePageSchema()]}
>
  <Header />
  <main class="info-page">
    <section class="info-copy" aria-label="Biography">
      <p>{site.intro}</p>
      <p>{site.bio}</p>
      <p>{site.inquiry}</p>

      <h1>Expertise:</h1>
      <ul>
        {site.expertise.map((item) => <li>– {item}</li>)}
      </ul>

      <h2>Contact:</h2>
      <p>{site.phone}</p>
      <ul>
        {site.social.map((link) => <li><a href={link.url}>{link.label}</a></li>)}
      </ul>
    </section>

    <section class="info-list" aria-label="Clients and recognition">
      <h2>Clients:</h2>
      <ul>
        {site.clients.map((client) => <li>{client}</li>)}
      </ul>

      <h2>Selection:</h2>
      <ul>
        {site.selection.map((item) => <li>{item}</li>)}
      </ul>

      <h2>Featured in:</h2>
      <ul>
        {site.featuredIn.map((item) => <li>{item}</li>)}
      </ul>
    </section>
  </main>
</BaseLayout>
